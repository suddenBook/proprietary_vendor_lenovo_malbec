on post-fs-data
    mkdir /data/lrootfs 0777 root root
    mkdir /data/lrootfs/opt 0771 root root
    mkdir /data/lrootfs/opt/kingsoft 0771 root root
    mkdir /dev/shm 1777 root 7200
    mkdir /dev/pcsys 0777 root 7200
    mkdir /dev/pcsys/rdp 0777 root 7200
    restorecon /dev/shm
    restorecon /dev/pcsys/rdp
    restorecon /dev/lrootfs

service check_if_config_base_env /vendor/bin/lrootfs.sh "check_if_config_base_env"
    class core
    user 7200
    disabled
    oneshot

service start_pcsys /vendor/bin/lrootfs.sh "start_pcsys"
    class core
    user root
    disabled
    oneshot

service mon_heartbeat /vendor/bin/lrootfs.sh "mon_heartbeat"
    class core
    user root
    disabled
    oneshot

service set_pcsys_pid /vendor/bin/lrootfs.sh "set_pcsys_pid"
    class core
    user root
    disabled
    oneshot

service update_imgs /vendor/bin/lrootfs.sh "update_imgs"
    class core
    user root
    disabled
    oneshot

service app_cleanup /vendor/bin/lrootfs.sh "app_cleanup"
    class core
    user 7200
    disabled
    oneshot

service unistall_app /vendor/bin/lrootfs.sh "unistall_app"
    class core
    user root
    disabled
    oneshot

service set_timezone /vendor/bin/lrootfs.sh "set_timezone"
    class core
    user root
    disabled
    oneshot

service set_con_dns /vendor/bin/lrootfs.sh "set_con_dns"
    class core
    user root
    disabled
    oneshot

service reset_lrootfs /vendor/bin/lrootfs.sh "reset_lrootfs"
    class core
    user root
    disabled
    oneshot

service reset_wps_files /vendor/bin/lrootfs.sh "reset_wps_files"
    class core
    user root
    disabled
    oneshot

service enable_channel /vendor/bin/lrootfs.sh "enable_channel"
    class core
    user root
    disabled
    oneshot

on property:vendor.zuxos.pcengine.container.start=1 && property:vendor.zuxos.pcengine.container.state=""
    chown 7200 7200 /dev/shm
    mount none /dev /data/lrootfs/dev bind rec
    mount none /dev/pts /data/lrootfs/dev/pts bind rec
    mount none /sys /data/lrootfs/sys bind rec
    mount none /proc /data/lrootfs/proc bind rec
    setprop vendor.zuxos.pcengine.container.state 1

on property:vendor.zuxos.pcengine.container.start=1 && property:vendor.zuxos.pcengine.container.state=1
    mkdir /dev/shm 1777 root 7200
    mkdir /dev/pcsys 0777 root 7200
    mkdir /dev/pcsys/rdp 0777 root 7200
    mkdir /data/lrootfs/tablet 0771 root root
    restorecon /data/lrootfs/mnt/pcsys/log
    restorecon /data/lrootfs/mnt/pcsys/log/lrootfs.log
    restorecon /dev/shm
    restorecon /dev/pcsys/rdp
    umount /data/lrootfs/tablet
    mount none /storage/self/primary /data/lrootfs/tablet bind rec
    start enable_channel
    start start_pcsys

on property:vendor.zuxos.pcengine.container.start=0
    stop start_pcsys
    stop mon_heartbeat

on property:vendor.zuxos.pcengine.container.start=1 && property:vendor.zuxos.pcengine.heartbeat=*
    start mon_heartbeat

on property:vendor.zuxos.pcengine.app.update=*
    start update_imgs

on property:vendor.zuxos.pcengine.app.clean=*
    start app_cleanup

on property:vendor.zuxos.pcengine.app.uninstall=*
    start unistall_app

on property:persist.vendor.zuxos.pcengine.lrootfs.dns=*
    start set_con_dns

on property:vendor.zuxos.pcengine.container.reset=1
    start reset_lrootfs

on property:persist.sys.timezone=*
    start set_timezone

on property:vendor.zuxos.pcengine.mount.start=1 && property:vendor.zuxos.pcengine.img.loopdevice=* && property:vendor.zuxos.pcengine.img.mountpath=*
    mount erofs ${vendor.zuxos.pcengine.img.loopdevice} ${vendor.zuxos.pcengine.img.mountpath} ro
    setprop vendor.zuxos.pcengine.mount.start 0

on property:vendor.zuxos.pcengine.kingsoft.exists=1
    start reset_wps_files
    setprop vendor.zuxos.pcengine.kingsoft.exists 0

on property:sys.boot_completed=1
    start check_if_config_base_env

on property:vendor.zuxos.pcengine.usb.mount.pardir=* && property:vendor.zuxos.pcengine.usb.mount.subdir=* && property:vendor.zuxos.pcengine.usb.mount.start=1 && property:vendor.zuxos.pcengine.external.storage=1
    mkdir /storage/self/primary/usb/ 0771 root root
    mkdir /storage/self/primary/usb/${vendor.zuxos.pcengine.usb.mount.subdir} 0771 root root
    umount /storage/self/primary/usb/${vendor.zuxos.pcengine.usb.mount.subdir}
    mount none ${vendor.zuxos.pcengine.usb.mount.pardir}/${vendor.zuxos.pcengine.usb.mount.subdir} /storage/self/primary/usb/${vendor.zuxos.pcengine.usb.mount.subdir} bind rec

on property:vendor.zuxos.pcengine.usb.mount.start=0 && property:vendor.zuxos.pcengine.external.storage=1
    umount /storage/self/primary/usb/${vendor.zuxos.pcengine.usb.mount.subdir}
    exec - root root -- /bin/rm -rf /storage/self/primary/usb/${vendor.zuxos.pcengine.usb.mount.subdir}
