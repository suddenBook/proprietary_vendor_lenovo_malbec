service vendor.face-default /vendor/bin/hw/android.hardware.biometrics.face@4.0-service.face
    interface aidl android.hardware.biometrics.face.IFace/default
    class hal
    user system
    group camera system

# TN Begin Added by hongbochen1 for BCR face dump
on boot
    mkdir /data/vendor/arcsoft 0775 system system
    restorecon_recursive /data/vendor/arcsoft
    chmod 0775 /data/vendor/arcsoft

# TN End Added by hongbochen1 for BCR face dump

