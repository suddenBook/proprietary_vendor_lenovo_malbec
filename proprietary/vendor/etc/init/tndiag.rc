service tndiag /vendor/bin/tndiag
    class core
    user root
    group root system vendor_qti_diag sdcard_rw cache
    seclabel u:r:tndiag:s0

on property:persist.vendor.diag.tndiag.enabled=1
    start tndiag

on property:persist.vendor.diag.tndiag.enabled=0
    stop tndiag

on boot
  mkdir /mnt/vendor/persist/wcn7750 0770 system system
  mkdir /mnt/vendor/persist/bluetooth 0770 system system
